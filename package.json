{
  "name": "whatsapp-bot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:worker": "tsx watch --env-file=.env src/worker/index.ts",
    "build": "npm run db:generate && next build && npm run build:worker",
    "build:worker": "node scripts/build-worker.mjs",
    "start:web": "next start",
    "start:worker": "node dist/worker/index.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@date-fns/tz": "1.5.0",
    "@hookform/resolvers": "7.0.6",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "4.4.0",
    "dotenv": "18.0.10",
    "jose": "6.2.17",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prisma": "7.10.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.92.0",
    "server-only": "0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pino-pretty": "13.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "@whiskeysockets/baileys@7.0.0-rc14": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "protobufjs@7.6.6": true
  },
  "engines": {
    "node": ">=24 <25"
  }
}
