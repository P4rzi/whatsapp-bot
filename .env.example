# Copie para .env e preencha. Nunca versione o .env.
# Descrição de cada variável e como configurar no Railway: docs/DEPLOY.md

NODE_ENV=development

# PostgreSQL. Em desenvolvimento: DATABASE_PUBLIC_URL do Postgres de desenvolvimento no Railway.
DATABASE_URL=

# [web] Segredo para assinar o cookie de sessão (mín. 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar este valor desloga todo mundo.
AUTH_SECRET=

# [worker] Pasta das credenciais do WhatsApp. No Railway: /app/data/whatsapp-session (volume).
WHATSAPP_SESSION_PATH=./data/whatsapp-session

# [worker] Chave AES-256 para criptografar a sessão do WhatsApp (64 caracteres hex). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar esta chave invalida a sessão salva (será preciso ler o QR Code de novo).
ENCRYPTION_KEY=

# [worker] Intervalo entre ciclos de busca de cobranças vencidas (ms).
WORKER_POLL_INTERVAL_MS=10000

# [worker] Tentativas automáticas por cobrança (só quando é seguro tentar de novo).
MESSAGE_MAX_ATTEMPTS=3

# [worker] Intervalo mínimo entre dois envios seguidos (ms).
MESSAGE_MIN_INTERVAL_MS=5000

# [worker] Tempo máximo esperando a confirmação de um envio (ms). Passou disso: resultado desconhecido.
MESSAGE_SEND_TIMEOUT_MS=30000

# [worker] Dias de retenção do histórico de tentativas (LGPD).
RETENTION_DAYS=180

# Fuso do negócio. Mantenha America/Sao_Paulo.
TIMEZONE=America/Sao_Paulo

# Nível de log: fatal, error, warn, info, debug.
LOG_LEVEL=info

# Só para criar o administrador com `npm run admin:create` (não são lidas pelo painel).
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=
