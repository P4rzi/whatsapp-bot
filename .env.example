# Copie para .env e preencha. Nunca versione o .env.
# Detalhes de cada variável e como configurar no Railway: docs/DEPLOY.md

NODE_ENV=development

# PostgreSQL. Em desenvolvimento: DATABASE_PUBLIC_URL do serviço Postgres-dev no Railway.
DATABASE_URL=

# Segredo para assinar o cookie de sessão (web). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Pasta das credenciais do WhatsApp (somente worker). No Railway: /app/data/whatsapp-session
WHATSAPP_SESSION_PATH=./data/whatsapp-session

# Chave AES-256 para criptografar a sessão do WhatsApp (64 caracteres hex). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar essa chave invalida a sessão salva (será preciso ler o QR Code de novo).
ENCRYPTION_KEY=

WORKER_POLL_INTERVAL_MS=10000

MESSAGE_MAX_ATTEMPTS=3

TIMEZONE=America/Sao_Paulo

LOG_LEVEL=info
